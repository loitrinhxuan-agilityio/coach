{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": [
      "api/**",
      "infra/**",
      "tools/**",
      "*.json",
      "*.ts",
      "!**/node_modules",
      "!**/cdk.out"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "enabled": true
  }
}
